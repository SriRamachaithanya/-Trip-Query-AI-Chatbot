# ==============================================================================
# Trip Query AI Chatbot - Environment Configuration (.env.example)
# Copy this file to .env and customize as needed. Never commit .env to Git.
# ==============================================================================

# LLM Provider Configuration
# Supported options: 'ollama' | 'openai' | 'mock'
LLM_PROVIDER=ollama

# Ollama Settings (for local execution)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
EMBEDDING_MODEL=mxbai-embed-large

# OpenAI / Compatible Settings (optional fallback / alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Vector Database Settings
CHROMA_PERSIST_DIRECTORY=./chroma_db
RETRIEVER_K=4

# Evaluation Harness Settings
EVAL_DATASET_PATH=evals/datasets/v1.jsonl
EVAL_ENABLE_JUDGE=false
EVAL_JUDGE_MODEL=llama3.2
EVAL_REPORTS_DIR=evals/reports

# Tracing & Observability
TRACING_ENABLED=true
TRACE_DIR=traces
LOG_LEVEL=INFO
